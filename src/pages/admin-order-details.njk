<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if order %}Order #{{ order.orderId }} | {% endif %}Orders | Admin | Shop</title>
    <link rel="stylesheet" href="/styles.css">
</head>

<body>
    {% set activeNav = "orders" %}
    {% include "partials/admin-nav.njk" %}

    <main class="container">
        <p><a href="/admin/orders" class="admin-back-link">&larr; Return to order list</a></p>

        {% if notFound %}
        <h1 class="section-heading">Order not found</h1>
        <p class="order-empty">This order does not exist.</p>
        {% elif error %}
        <h1 class="section-heading">Order details</h1>
        <div class="error-message" role="alert">
            {{ error }}
            <a href="/admin/orders/{{ orderId | string | urlencode }}">Retry</a>
        </div>
        {% else %}
        <h1 class="section-heading">Order #{{ order.orderId }}</h1>

        {% if updated %}
        <div class="success-message" role="status">The order status has been updated to {{ updated }}.</div>
        {% endif %}
        {% if statusError == "invalid" %}
        <div class="error-message" role="alert">That status change is not allowed for this order. Please choose one of the available statuses.</div>
        {% elif statusError == "forbidden" %}
        <div class="error-message" role="alert">You do not have permission to update order status.</div>
        {% elif statusError == "failed" %}
        <div class="error-message" role="alert">The order status could not be updated. Please try again.</div>
        {% endif %}

        <div class="activity-grid admin-details-grid">
            <section class="profile-card" aria-labelledby="order-information">
                <h2 id="order-information">Order information</h2>
                <dl class="profile-details">
                    <div class="profile-row">
                        <dt>Order ID</dt>
                        <dd>#{{ order.orderId }}</dd>
                    </div>
                    <div class="profile-row">
                        <dt>Order date</dt>
                        <dd>{{ order.displayOrderDate }}</dd>
                    </div>
                    <div class="profile-row">
                        <dt>Last updated</dt>
                        <dd>{{ order.displayLastUpdated }}</dd>
                    </div>
                    <div class="profile-row">
                        <dt>Current status</dt>
                        <dd><span class="order-status{% if order.status == "CANCELLED" %} status-suspended{% endif %}">{{ order.statusLabel }}</span></dd>
                    </div>
                </dl>

                {% if canUpdateStatus %}
                <form action="{{ order.detailsHref }}/status" method="post" class="admin-user-actions">
                    <input type="hidden" name="{{ submissionField }}" value="{{ submissionToken() }}">
                    <label for="order-status-select">Update status</label>
                    <select id="order-status-select" name="status" required>
                        {% for transition in order.transitions %}
                        <option value="{{ transition.value }}">{{ transition.label }}</option>
                        {% endfor %}
                    </select>
                    <button type="submit" class="btn btn--secondary">Update status</button>
                </form>
                {% endif %}
            </section>

            <section class="profile-card" aria-labelledby="customer-information">
                <h2 id="customer-information">Customer details</h2>
                <dl class="profile-details">
                    <div class="profile-row">
                        <dt>Name</dt>
                        <dd>{{ order.customer.name }}</dd>
                    </div>
                    <div class="profile-row">
                        <dt>Email</dt>
                        <dd>{{ order.customer.email }}</dd>
                    </div>
                    {% if order.addressLines | length %}
                    <div class="profile-row">
                        <dt>Address</dt>
                        <dd>{% for line in order.addressLines %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</dd>
                    </div>
                    {% endif %}
                </dl>
            </section>
        </div>

        <section class="order-card admin-table-card" aria-labelledby="order-items">
            <h2 id="order-items" class="admin-card-heading">Ordered items</h2>
            {% if order.items | length %}
            <table class="order-items admin-table">
                <thead>
                    <tr>
                        <th scope="col">Product</th>
                        <th scope="col" class="admin-numeric">Quantity</th>
                        <th scope="col" class="admin-numeric">Unit price</th>
                        <th scope="col" class="admin-numeric">Total price</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in order.items %}
                    <tr>
                        <td>{{ item.productName }}</td>
                        <td class="admin-numeric">{{ item.quantity }}</td>
                        <td class="admin-numeric">{{ item.displayUnitPrice }}</td>
                        <td class="admin-numeric">{{ item.displayItemTotal }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% else %}
            <p class="order-empty" role="status">This order has no items.</p>
            {% endif %}

            <dl class="admin-basket-summary" aria-label="Order summary">
                <div class="summary-row">
                    <dt>Total items</dt>
                    <dd>{{ order.itemCount }}</dd>
                </div>
                <div class="summary-row summary-row--total">
                    <dt>Order total</dt>
                    <dd>{{ order.displayOrderTotal }}</dd>
                </div>
            </dl>
        </section>
        {% endif %}
    </main>
</body>

</html>
