<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Account | Shop</title>
    <link rel="stylesheet" href="styles.css">
</head>

<body>
    <header class="navbar">
        <a href="/products" class="navbar-brand">Home</a>

        <input type="checkbox" id="menu-toggle" class="menu-toggle">
        <label for="menu-toggle" class="menu-button">
            <span>Menu</span>
            <span class="menu-arrow"></span>
        </label>

        <nav class="dropdown">
            <ul class="category-links">
                <li><a href="/products">All</a></li>
                <li><a href="/products?category=Category1">Category 1</a></li>
                <li><a href="/products?category=Category2">Category 2</a></li>
                <li><a href="/products?category=Category3">Category 3</a></li>
            </ul>

            <div class="dropdown-actions">
                <a href="/profile" class="action-button">Account</a>
                <a href="/basket" class="action-button">Basket <span class="basket-count">{{ basketCount or 0 }}</span></a>
            </div>
        </nav>
    </header>

    <div class="search-bar">
        <form action="/products" method="get" class="search-form">
            <input type="search" name="q" placeholder="Search products">
            <button type="submit">Search</button>
        </form>
    </div>

    <main class="container">
        <h1 class="section-heading">My Account</h1>

        <section class="profile-card">
            <h2>Your details</h2>

            <dl class="profile-details">
                <div class="profile-row">
                    <dt>Name</dt>
                    <dd>{{ user.firstName }} {{ user.lastName }}</dd>
                </div>

                <div class="profile-row">
                    <dt>Email</dt>
                    <dd>{{ user.email }}</dd>
                </div>

                {% if user.phone %}
                <div class="profile-row">
                    <dt>Phone</dt>
                    <dd>{{ user.phone }}</dd>
                </div>
                {% endif %}

                {% if user.address %}
                <div class="profile-row">
                    <dt>Address</dt>
                    <dd>
                        {{ user.address.line1 }}<br>
                        {% if user.address.line2 %}{{ user.address.line2 }}<br>{% endif %}
                        {{ user.address.city }}<br>
                        {{ user.address.postcode }}
                    </dd>
                </div>
                {% endif %}

                <div class="profile-row">
                    <dt>Member since</dt>
                    <dd>{{ user.memberSince }}</dd>
                </div>
            </dl>

        </section>

        <h2 class="section-heading">Order History</h2>

        {% if error %}
        <p class="error-message" role="alert">{{ error }}</p>
        {% endif %}

        {% if orders and orders.length %}
        <section class="order-list">
            {% for order in orders %}
            <article class="order-card">
                <div class="order-header">
                    <h3>Order #{{ order.orderNumber or order.id }}</h3>
                    <p class="order-meta">
                        Placed {{ order.placedAt }}
                        <span class="order-status">{{ order.status }}</span>
                    </p>
                </div>

                {% if order.items and order.items.length %}
                <table class="order-items">
                    <thead>
                        <tr>
                            <th scope="col">Item</th>
                            <th scope="col">Qty</th>
                            <th scope="col">Price</th>
                            <th scope="col">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in order.items %}
                        <tr>
                            <td>{{ item.productName }}</td>
                            <td>{{ item.quantity }}</td>
                            <td>{{ item.displayUnitPrice }}</td>
                            <td>{{ item.displaySubtotal }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                    <tfoot>
                        <tr>
                            <th scope="row" colspan="3">Total</th>
                            <td class="order-total">{{ order.displayTotal }}</td>
                        </tr>
                    </tfoot>
                </table>
                {% else %}
                <p class="order-empty">No items found for this order.</p>
                {% endif %}
            </article>
            {% endfor %}
        </section>
        {% elif not error %}
        <section class="profile-card profile-empty">
            <p>You haven't placed any orders yet.</p>
            <a href="/products" class="btn btn--primary">Start shopping</a>
        </section>
        {% endif %}
    </main>
</body>

</html>