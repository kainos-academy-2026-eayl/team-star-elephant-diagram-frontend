<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Baskets | Admin | Sedshed</title>
    <link rel="stylesheet" href="/admin.css">
    <script src="/admin.js" defer></script>
</head>

<body class="admin">
    {% set activeNav = "baskets" %}
    {% set searchAction = "/admin/baskets" %}
    {% set searchLabel = "Search baskets" %}
    {% set searchPlaceholder = "Search by basket ID, customer name or email" %}
    {% include "partials/admin-nav.njk" %}

    <main id="main" class="admin-main">
        <header class="admin-page-head">
            <p class="admin-page-head__eyebrow">Shopping</p>
            <h1 class="admin-page-head__title">Active baskets</h1>
            {% if search %}<p class="admin-page-head__meta">Showing results for "{{ search }}"</p>{% endif %}
        </header>

        {% if error %}
        <div class="admin-alert admin-alert--error" role="alert">
            <span>{{ error }}</span>
            <a href="/admin/baskets{% if search %}?q={{ search | urlencode }}{% endif %}">Retry</a>
        </div>
        {% elif baskets | length %}
        <section class="admin-card admin-card--flush" aria-labelledby="baskets-table-caption">
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <caption id="baskets-table-caption" class="visually-hidden">Active customer baskets</caption>
                    <thead>
                        <tr>
                            <th scope="col">Basket ID</th>
                            <th scope="col">Customer name</th>
                            <th scope="col">Customer email</th>
                            <th scope="col" class="admin-numeric">Items</th>
                            <th scope="col" class="admin-numeric">Total</th>
                            <th scope="col">Last activity</th>
                            <th scope="col">Status</th>
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for basket in baskets %}
                        <tr>
                            <td class="admin-table__strong">#{{ basket.basketId }}</td>
                            <td>{{ basket.customerName }}</td>
                            <td>{{ basket.customerEmail }}</td>
                            <td class="admin-numeric">{{ basket.itemCount }}</td>
                            <td class="admin-numeric">{{ basket.total }}</td>
                            <td>{{ basket.lastActivity }}</td>
                            <td><span class="admin-status admin-status--success">{{ basket.status }}</span></td>
                            <td class="admin-table__action">
                                <a href="{{ basket.detailsHref }}" class="admin-btn admin-btn--ghost admin-btn--small">View basket<span class="visually-hidden"> #{{ basket.basketId }}</span></a>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
        {% elif search %}
        <p class="admin-empty admin-empty--panel" role="status">No baskets match "{{ search }}". <a href="/admin/baskets" class="admin-link">Clear search</a></p>
        {% else %}
        <p class="admin-empty admin-empty--panel" role="status">There are no active baskets.</p>
        {% endif %}
    </main>
</body>

</html>
