<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Users | Admin | Sedshed</title>
    <link rel="stylesheet" href="/admin.css">
</head>

<body class="admin">
    {% set activeNav = "users" %}
    {% set searchAction = "/admin/users" %}
    {% set searchLabel = "Search users by name or email" %}
    {% set searchPlaceholder = "Search by name or email" %}
    {% include "partials/admin-nav.njk" %}

    <main id="main" class="admin-main">
        <header class="admin-page-head">
            <p class="admin-page-head__eyebrow">Customers</p>
            <h1 class="admin-page-head__title">User accounts</h1>
            {% if search %}<p class="admin-page-head__meta">Showing results for "{{ search }}"</p>{% endif %}
        </header>

        {% if deleted %}
        <div class="admin-alert admin-alert--success" role="status">The customer and their associated data have been permanently deleted.</div>
        {% endif %}
        {% if error %}
        <div class="admin-alert admin-alert--error" role="alert">
            <span>{{ error }}</span>
            <a href="/admin/users{% if search %}?q={{ search | urlencode }}{% endif %}">Retry</a>
        </div>
        {% else %}

        <section class="admin-card admin-card--flush" aria-label="User accounts">
            {% if users | length %}
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th scope="col">Customer name</th>
                            <th scope="col">Email</th>
                            <th scope="col">Registered</th>
                            <th scope="col">Status</th>
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in users %}
                        <tr>
                            <td class="admin-table__strong">{{ user.name }}</td>
                            <td>{{ user.email }}</td>
                            <td>{{ user.displayRegisteredAt }}</td>
                            <td><span class="admin-status{% if user.isSuspended %} admin-status--danger{% else %} admin-status--success{% endif %}">{{ user.statusLabel }}</span></td>
                            <td class="admin-table__action">
                                <a href="{{ user.detailsHref }}" class="admin-btn admin-btn--ghost admin-btn--small">View details<span class="visually-hidden"> for {{ user.name }}</span></a>
                                {% include "partials/admin-user-actions.njk" %}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% else %}
            <p class="admin-empty admin-empty--panel" role="status">
                {% if search %}No users match "{{ search }}". <a href="/admin/users" class="admin-link">Clear search</a>{% else %}No user accounts found.{% endif %}
            </p>
            {% endif %}
        </section>

        {% if pagination %}
        <nav class="admin-pagination" aria-label="User list pages">
            {% if pagination.previousHref %}<a href="{{ pagination.previousHref }}" class="admin-btn admin-btn--ghost">Previous</a>{% endif %}
            <span>Page {{ pagination.page }} of {{ pagination.totalPages }}</span>
            {% if pagination.nextHref %}<a href="{{ pagination.nextHref }}" class="admin-btn admin-btn--ghost">Next</a>{% endif %}
        </nav>
        {% endif %}

        {% endif %}
    </main>
</body>

</html>
