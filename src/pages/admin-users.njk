<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Users | Admin | Shop</title>
    <link rel="stylesheet" href="/styles.css">
</head>

<body>
    {% set activeNav = "users" %}
    {% include "partials/admin-nav.njk" %}

    <div class="search-bar">
        <form action="/admin/users" method="get" class="search-form" role="search">
            <label for="user-search" class="visually-hidden">Search users by name or email</label>
            <input type="search" id="user-search" name="q" maxlength="100" placeholder="Search by name or email" value="{{ search }}">
            <button type="submit">Search</button>
        </form>
    </div>

    <main class="container">
        <h1 class="section-heading">User accounts</h1>

        {% if error %}
        <div class="error-message" role="alert">
            {{ error }}
            <a href="/admin/users{% if search %}?q={{ search | urlencode }}{% endif %}">Retry</a>
        </div>
        {% else %}

        <section class="order-card admin-users" aria-label="User accounts">
            {% if users | length %}
            <table class="order-items admin-users-table">
                <thead>
                    <tr>
                        <th scope="col">Customer name</th>
                        <th scope="col">Email</th>
                        <th scope="col">Registered</th>
                        <th scope="col">Status</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                    <tr>
                        <td>{{ user.name }}</td>
                        <td>{{ user.email }}</td>
                        <td>{{ user.displayRegisteredAt }}</td>
                        <td><span class="order-status{% if user.isSuspended %} status-suspended{% endif %}">{{ user.statusLabel }}</span></td>
                        <td><a href="{{ user.detailsHref }}" class="action-button admin-view-button">View details<span class="visually-hidden"> for {{ user.name }}</span></a></td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% else %}
            <p class="order-empty admin-users-empty">
                {% if search %}No users match "{{ search }}".{% else %}No user accounts found.{% endif %}
            </p>
            {% endif %}
        </section>

        {% if pagination %}
        <nav class="pagination" aria-label="User list pages">
            {% if pagination.previousHref %}<a href="{{ pagination.previousHref }}" class="action-button">Previous</a>{% endif %}
            <span>Page {{ pagination.page }} of {{ pagination.totalPages }}</span>
            {% if pagination.nextHref %}<a href="{{ pagination.nextHref }}" class="action-button">Next</a>{% endif %}
        </nav>
        {% endif %}

        {% endif %}
    </main>
</body>

</html>
