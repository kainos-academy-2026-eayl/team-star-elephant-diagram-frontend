<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>Order review</title>
	<link rel="stylesheet" href="/styles.css" />
</head>

<body>
	<nav class="navbar">
		<a href="/products" class="navbar-brand">Products</a>

		<input type="checkbox" id="menu-toggle" class="menu-toggle" />
		<label for="menu-toggle" class="menu-button">
			<span>Menu</span>
			<span class="menu-arrow"></span>
		</label>

		<div class="dropdown">
			<ul class="category-links">
				<li><a href="/products">All products</a></li>
			</ul>

			<div class="dropdown-actions">
				<a href="/login" class="action-button">Account</a>
			</div>
		</div>
		<a href="/basket" class="action-button navbar-basket">Basket <span class="basket-count">0</span></a>
	</nav>

	<main class="container">
		<h1 class="section-heading">Order review</h1>

		{% if error %}
		<div class="checkout-error" role="alert">
			{{ error }}
			{% if loginRequired %}
			<p><a href="/login">Log in to your account</a></p>
			{% endif %}
		</div>
		{% endif %}

		{% if checkout %}
		<div class="checkout-layout">
			<section class="checkout-card" aria-labelledby="order-heading">
				<h2 id="order-heading">Order details</h2>

				<ul class="checkout-items">
					{% for item in checkout.items %}
					<li class="checkout-item">
						<div class="checkout-item__info">
							<h3 class="checkout-item__name">{{ item.productName }}</h3>
							<p class="checkout-item__quantity">Quantity: {{ item.quantity }}</p>
						</div>
						<div class="checkout-item__prices">
							<span class="checkout-item__unit-price">{{ item.displayUnitPrice }} each</span>
							<span class="checkout-item__subtotal">{{ item.displaySubtotal }}</span>
						</div>
					</li>
					{% endfor %}
				</ul>
			</section>

			<aside class="checkout-summary" aria-labelledby="summary-heading">
				<h2 id="summary-heading">Order summary</h2>

				<div class="summary-rows">
					<div class="summary-row">
						<span>Items</span>
						<span>{{ checkout.itemCount }}</span>
					</div>
					<div class="summary-row">
						<span>Subtotal</span>
						<span>{{ checkout.displaySubtotal }}</span>
					</div>
					<div class="summary-row">
						<span>Shipping</span>
						<span>{{ checkout.displayShippingFee }}</span>
					</div>
					<div class="summary-row summary-row--total">
						<span>Total</span>
						<span>{{ checkout.displayTotal }}</span>
					</div>
				</div>

				<div class="checkout-actions">
					<a href="/payment_gateway" class="btn btn--primary">Continue to payment</a>
					<a href="/products" class="btn btn--secondary">Continue shopping</a>
				</div>
			</aside>
		</div>
		{% endif %}
	</main>
</body>

</html>