<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>Payment</title>
	<link rel="stylesheet" href="/styles.css" />
</head>

<body>
	<nav class="navbar">
		<a href="/products" class="navbar-brand">Products</a>

		<input type="checkbox" id="menu-toggle" class="menu-toggle" />
		<label for="menu-toggle" class="menu-button">
			<span>Menu</span>
			<span class="menu-arrow"></span>
		</label>

		<div class="dropdown">
			<ul class="category-links">
				<li><a href="/products">All products</a></li>
			</ul>

			<div class="dropdown-actions">
				<a href="/login" class="action-button">Account</a>
			</div>
		</div>
		<a href="/basket" class="action-button navbar-basket">Basket <span class="basket-count">0</span></a>
	</nav>

	<main class="container">
		<h1 class="section-heading">Payment</h1>

		{% if error %}
		<div class="payment-error" role="alert">
			{{ error }}
			{% if loginRequired %}
			<p><a href="/login">Log in to your account</a></p>
			{% endif %}
		</div>
		{% endif %}

		{% if payment and payment.status %}
		<div class="payment-success" role="status">
			<h2>{{ payment.message }}</h2>
		</div>
		{% else %}
		<div class="payment-layout">
			<section class="payment-card" aria-labelledby="payment-heading">
				<h2 id="payment-heading">Payment details</h2>
				<p class="payment-intro">Enter your card and shipping information to complete your purchase.</p>

				<form class="payment-form" action="/payment_gateway" method="post">
					<fieldset class="payment-fieldset">
						<legend class="payment-legend">Card information</legend>

						<div class="field">
							<label for="nameoncard">Name on card</label>
							<input type="text" id="nameoncard" name="nameOnCard" autocomplete="cc-name" maxlength="50" required>
						</div>

						<div class="field">
							<label for="cardnumber">Card number</label>
							<input type="text" id="cardnumber" name="cardNumber" autocomplete="cc-number" maxlength="23" placeholder="0000 0000 0000 0000" required>
						</div>

						<div class="payment-row">
							<div class="field">
								<label for="expiry">Expiry date</label>
								<input type="text" id="expiry" name="expiry" autocomplete="cc-exp" maxlength="5" placeholder="MM/YY" required>
							</div>
							<div class="field">
								<label for="cvc">Security code</label>
								<input type="text" id="cvc" name="cvc" autocomplete="cc-csc" maxlength="4" placeholder="CVC" required>
							</div>
						</div>
					</fieldset>

					<fieldset class="payment-fieldset">
						<legend class="payment-legend">Shipping address</legend>

						<div class="field">
							<label for="fullname">Full name</label>
							<input type="text" id="fullname" name="fullName" autocomplete="name" maxlength="100" required>
						</div>

						<div class="field">
							<label for="address1">Street address</label>
							<input type="text" id="address1" name="addressLine1" autocomplete="street-address" maxlength="100" required>
						</div>

						<div class="field">
							<label for="address2">Apartment, suite, etc. (optional)</label>
							<input type="text" id="address2" name="addressLine2" autocomplete="address-line2" maxlength="100">
						</div>

						<div class="payment-row">
							<div class="field">
								<label for="city">City</label>
								<input type="text" id="city" name="city" autocomplete="address-level2" maxlength="50" required>
							</div>
							<div class="field">
								<label for="postcode">Postcode</label>
								<input type="text" id="postcode" name="postcode" autocomplete="postal-code" maxlength="20" required>
							</div>
						</div>

						<div class="field">
							<label for="country">Country</label>
							<input type="text" id="country" name="country" autocomplete="country-name" maxlength="50" required>
						</div>
					</fieldset>

					<div class="payment-actions">
						<button type="submit" class="btn btn--primary">Submit payment</button>
						<a href="/checkout" class="btn btn--secondary">Back to order</a>
					</div>
				</form>
			</section>
		</div>
		{% endif %}
	</main>
</body>

</html>
