{%- import "partials/icons.njk" as i -%}
{%- set currentNav = "shop-all" -%}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if product %}{{ product.name }} | Sedshed{% else %}Product not found | Sedshed{% endif %}</title>
    <link rel="stylesheet" href="/site.css">
    <link rel="stylesheet" href="/product-detail.css">
</head>

<body class="site">
    {% include "partials/site-header.njk" %}

    <main class="product-page">
        {% if error %}
        <p class="notice notice--error" role="alert">{{ error }}</p>
        <a class="back-link" href="/products">{{ i.icon("arrow") }}<span>Return to the product catalogue</span></a>
        {% elif product %}
        <nav class="breadcrumb" aria-label="Breadcrumb">
            <ol>
                <li><a href="/products">Shop All</a></li>
                <li><a href="/products?category={{ product.category | urlencode }}">{{ product.category }}</a></li>
                <li aria-current="page">{{ product.name }}</li>
            </ol>
        </nav>
        <section class="product-detail" aria-labelledby="product-title">
            <div class="product-gallery" aria-label="Product images">
                {% if product.images and product.images.length > 1 %}
                {# CSS-only carousel: each hidden radio shows the slide directly after it; arrows are labels for the neighbouring radios. #}
                <div class="carousel">
                    {% for image in product.images %}
                    <input class="carousel__radio" type="radio" name="product-gallery" id="gallery-{{ loop.index }}" aria-label="Show image {{ loop.index }} of {{ loop.length }}"{% if loop.first %} checked{% endif %}>
                    <figure class="carousel__slide">
                        <img src="{{ image.url }}" alt="{{ image.altText or product.name }}"{% if not loop.first %} loading="lazy"{% endif %}>
                        <label class="carousel__arrow carousel__arrow--prev" for="gallery-{{ loop.length if loop.first else loop.index - 1 }}" title="Previous image" aria-hidden="true">&#8249;</label>
                        <label class="carousel__arrow carousel__arrow--next" for="gallery-{{ 1 if loop.last else loop.index + 1 }}" title="Next image" aria-hidden="true">&#8250;</label>
                        <figcaption class="carousel__count">{{ loop.index }} / {{ loop.length }}</figcaption>
                    </figure>
                    {% endfor %}
                </div>
                {% elif product.images and product.images.length %}
                <img src="{{ product.images[0].url }}" alt="{{ product.images[0].altText or product.name }}">
                {% elif product.imageURL %}
                <img src="{{ product.imageURL }}" alt="{{ product.name }}">
                {% else %}
                <div class="product-gallery__placeholder" role="img" aria-label="No product image available">{{ i.icon("box") }}</div>
                {% endif %}
            </div>

            <div class="product-detail__info">
                <p class="product-detail__category"><a href="/products?category={{ product.category | urlencode }}">{{ product.category }}</a></p>
                <h1 class="product-detail__title" id="product-title">{{ product.name }}</h1>
                <p class="product-detail__price">{{ product.formattedPrice }}</p>

                {% if product.description | length > 160 %}
                <details class="product-detail__description">
                    <summary>
                        <span class="product-detail__description-preview">{{ product.description | truncate(160, false, "…") }}</span>
                        <span class="product-detail__description-toggle">Read full description</span>
                    </summary>
                    <p>{{ product.description }}</p>
                </details>
                {% else %}
                <p class="product-detail__description">{{ product.description }}</p>
                {% endif %}

                {% if not product.inStock %}
                <p class="product-detail__stock product-detail__stock--unavailable" data-stock="0">Out of stock</p>
                {% elif product.lowStock %}
                <p class="product-detail__stock product-detail__stock--low" data-stock="{{ product.stockQuantity }}">Only {{ product.stockQuantity }} left in stock</p>
                {% else %}
                <p class="product-detail__stock product-detail__stock--available" data-stock="{{ product.stockQuantity }}">In stock</p>
                {% endif %}

                {% if basketMessage %}
                <p class="product-detail__message product-detail__message--{{ basketMessage.type }}" role="alert">{{ basketMessage.text }}</p>
                {% endif %}

                <form action="/basket" method="post" class="product-detail__form">
                    <input type="hidden" name="productId" value="{{ product.productId }}">
                    <div class="product-detail__quantity">
                        <label for="quantity">Quantity</label>
                        <input type="number" id="quantity" name="quantity" min="1" max="{{ product.maxOrderQuantity if product.inStock else 1 }}" step="1" value="1" inputmode="numeric" required{% if not product.inStock %} disabled{% endif %}>
                    </div>
                    <button type="submit" class="add-button"{% if not product.inStock %} disabled aria-disabled="true"{% endif %}>{% if product.inStock %}Add to basket{% else %}Out of stock{% endif %}</button>
                </form>
            </div>
        </section>
        {% else %}
        <section class="product-not-found" aria-labelledby="not-found-title">
            <h1 id="not-found-title">Product not found</h1>
            <p>This product may have been removed or the link may be incorrect.</p>
            <a class="back-link" href="/products">{{ i.icon("arrow") }}<span>Return to the product catalogue</span></a>
        </section>
        {% endif %}
    </main>

    {% include "partials/site-menu.njk" %}
</body>

</html>