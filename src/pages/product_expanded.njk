<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if product %}{{ product.name }} | Shop{% else %}Product not found | Shop{% endif %}</title>
    <link rel="stylesheet" href="/styles.css">
</head>

<body>
    <header class="navbar">
        <a href="/products" class="navbar-brand">Home</a>

        <input type="checkbox" id="menu-toggle" class="menu-toggle">
        <label for="menu-toggle" class="menu-button">
            <span>Menu</span>
            <span class="menu-arrow"></span>
        </label>

        <nav class="dropdown">
            <ul class="category-links">
                <li><a href="/products">All</a></li>
            </ul>

            <div class="dropdown-actions">
                <a href="/login" class="action-button">Account</a>
                <a href="/basket" class="action-button">Basket <span class="basket-count">0</span></a>
            </div>
        </nav>
    </header>

    <div class="search-bar">
        <form action="/products" method="get" class="search-form">
            <input type="search" name="q" placeholder="Search products">
            <button type="submit">Search</button>
        </form>
    </div>

    <main class="container">
        {% if error %}
        <p role="alert">{{ error }}</p>
        <a href="/products">Return to the product catalogue</a>
        {% elif product %}
        <a href="/products">Back to products</a>
        <section class="product-detail" aria-labelledby="product-title">
            <div class="product-gallery" aria-label="Product images">
                {% if product.imageURL %}
                <img src="{{ product.imageURL }}" alt="{{ product.name }}">
                {% else %}
                <div class="product-image" role="img" aria-label="No product image available"></div>
                {% endif %}
            </div>

            <div class="product-detail__info">
                <p class="product-detail__category"><a href="/products?category={{ product.category | urlencode }}">{{ product.category }}</a></p>
                <h1 class="product-detail__title" id="product-title">{{ product.name }}</h1>
                <p class="product-detail__price">{{ product.formattedPrice }}</p>

                {% if product.description | length > 160 %}
                <details class="product-detail__description">
                    <summary>
                        <span class="product-detail__description-preview">{{ product.description | truncate(160, false, "…") }}</span>
                        <span class="product-detail__description-toggle">Read full description</span>
                    </summary>
                    <p>{{ product.description }}</p>
                </details>
                {% else %}
                <p class="product-detail__description">{{ product.description }}</p>
                {% endif %}

                {% if not product.inStock %}
                <p class="product-detail__stock product-detail__stock--unavailable" data-stock="0">Out of stock</p>
                {% elif product.lowStock %}
                <p class="product-detail__stock product-detail__stock--low" data-stock="{{ product.stockQuantity }}">Only {{ product.stockQuantity }} left in stock</p>
                {% else %}
                <p class="product-detail__stock product-detail__stock--available" data-stock="{{ product.stockQuantity }}">In stock</p>
                {% endif %}

                {% if basketMessage %}
                <p class="product-detail__message product-detail__message--{{ basketMessage.type }}" role="alert">{{ basketMessage.text }}</p>
                {% endif %}

                <form action="/basket" method="post" class="product-detail__form">
                    <input type="hidden" name="productId" value="{{ product.productId }}">
                    <div class="product-detail__quantity">
                        <label for="quantity">Quantity</label>
                        <input type="number" id="quantity" name="quantity" min="1" max="{{ product.maxOrderQuantity if product.inStock else 1 }}" step="1" value="1" inputmode="numeric" required{% if not product.inStock %} disabled{% endif %}>
                    </div>
                    <button type="submit" class="add-button"{% if not product.inStock %} disabled aria-disabled="true"{% endif %}>{% if product.inStock %}Add to basket{% else %}Out of stock{% endif %}</button>
                </form>
            </div>
        </section>
        {% else %}
        <section class="product-not-found" aria-labelledby="not-found-title">
            <h1 id="not-found-title">Product not found</h1>
            <p>This product may have been removed or the link may be incorrect.</p>
            <a href="/products">Return to the product catalogue</a>
        </section>
        {% endif %}
    </main>
</body>

</html>