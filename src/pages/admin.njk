<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if forbidden %}Access denied{% else %}Admin Dashboard{% endif %} | Sedshed</title>
    <link rel="stylesheet" href="/admin.css">
    <script src="/admin.js" defer></script>
</head>

<body class="admin">
    {% set activeNav = "" if forbidden else "dashboard" %}
    {% include "partials/admin-nav.njk" %}

    <main id="main" class="admin-main">
        {% if forbidden %}
        <section class="admin-denied" aria-labelledby="access-denied-title">
            <p class="admin-denied__code" aria-hidden="true">403</p>
            <h1 id="access-denied-title" class="admin-denied__title">Access denied</h1>
            <p class="admin-denied__message" role="alert">You do not have permission to view this page or perform this action.</p>
            <p class="admin-denied__hint">If you think you should have access, ask a Super Admin to review your role.</p>
            <div class="admin-denied__actions">
                <a href="/admin" class="admin-btn admin-btn--primary">Return to the dashboard</a>
            </div>
        </section>
        {% else %}
        <section class="admin-hero" aria-labelledby="dashboard-title">
            <p class="admin-hero__eyebrow">Staff portal</p>
            <h1 id="dashboard-title" class="admin-hero__title">Admin dashboard</h1>
            {% if staff and staff.name %}
            <p class="admin-hero__lead">Welcome back, <strong>{{ staff.name }}</strong>. Here is what is happening in the shop today.</p>
            {% endif %}
        </section>

        {% if error %}
        <div class="admin-alert admin-alert--error" role="alert">
            <span>{{ error }}</span>
            <a href="/admin">Retry</a>
        </div>
        {% else %}

        {% if quickActions | length %}
        <section class="admin-chips" aria-label="Quick actions">
            {% for action in quickActions %}
            {% if action.href %}
            <a href="{{ action.href }}" class="admin-chip admin-chip--link">{{ action.label }}</a>
            {% else %}
            <span class="admin-chip" aria-disabled="true">{{ action.label }} (Unavailable)</span>
            {% endif %}
            {% endfor %}
        </section>
        {% endif %}

        <section class="admin-stats" aria-label="Summary">
            {% for card in cards %}
            <div class="admin-stat">
                <h2 class="admin-stat__label">{{ card.label }}</h2>
                <p class="admin-stat__value">{{ card.value }}</p>
            </div>
            {% else %}
            <p class="admin-empty">No summary information is available.</p>
            {% endfor %}
        </section>

        <div class="admin-grid admin-grid--three">
            <section class="admin-card" aria-labelledby="latest-orders">
                <h2 id="latest-orders" class="admin-card__title">Latest orders</h2>
                <div class="admin-table-wrap">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th scope="col">Order</th>
                                <th scope="col">Customer</th>
                                <th scope="col">Date</th>
                                <th scope="col">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for order in recentOrders %}
                            <tr>
                                <td>#{{ order.id }}</td>
                                <td>{{ order.customer }}</td>
                                <td>{{ order.date }}</td>
                                <td><span class="admin-status">{{ order.status }}</span></td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="4" class="admin-empty">No recent orders.</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="admin-card" aria-labelledby="new-registrations">
                <h2 id="new-registrations" class="admin-card__title">New registrations</h2>
                <div class="admin-table-wrap">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th scope="col">Name</th>
                                <th scope="col">Email</th>
                                <th scope="col">Joined</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for user in newUsers %}
                            <tr>
                                <td>{{ user.name }}</td>
                                <td>{{ user.email }}</td>
                                <td>{{ user.joined }}</td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="3" class="admin-empty">No new registrations.</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="admin-card" aria-labelledby="stock-changes">
                <h2 id="stock-changes" class="admin-card__title">Recent stock changes</h2>
                <div class="admin-table-wrap">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th scope="col">Product</th>
                                <th scope="col" class="admin-numeric">Change</th>
                                <th scope="col">Reason</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for change in stockChanges %}
                            <tr>
                                <td>{{ change.product }}</td>
                                <td class="admin-numeric">{{ change.amount }}</td>
                                <td>{{ change.reason }}</td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="3" class="admin-empty">No recent stock changes.</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        {% endif %}
        {% endif %}
    </main>
</body>

</html>
