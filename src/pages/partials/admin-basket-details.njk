<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if basket %}Basket #{{ basket.basketId }} | {% endif %}Baskets | Admin | Sedshed</title>
    <link rel="stylesheet" href="/admin.css">
    <script src="/admin.js" defer></script>
</head>

<body class="admin">
    {% set activeNav = "baskets" %}
    {% include "partials/admin-nav.njk" %}

    <main id="main" class="admin-main">
        <a href="/admin/baskets" class="admin-back-link">&larr; Return to basket list</a>

        {% if notFound %}
        <header class="admin-page-head">
            <h1 class="admin-page-head__title">Basket not found</h1>
        </header>
        <p class="admin-empty admin-empty--panel">This basket does not exist or is no longer active.</p>
        {% elif error %}
        <header class="admin-page-head">
            <h1 class="admin-page-head__title">Basket details</h1>
        </header>
        <div class="admin-alert admin-alert--error" role="alert">
            <span>{{ error }}</span>
            <a href="/admin/baskets/{{ basketId | string | urlencode }}">Retry</a>
        </div>
        {% else %}
        <header class="admin-page-head">
            <p class="admin-page-head__eyebrow">Basket</p>
            <h1 class="admin-page-head__title">Basket #{{ basket.basketId }}</h1>
        </header>

        <div class="admin-grid admin-grid--two">
            <section class="admin-card" aria-labelledby="basket-information">
                <h2 id="basket-information" class="admin-card__title">Basket information</h2>
                <dl class="admin-details">
                    <div class="admin-details__row">
                        <dt>Basket ID</dt>
                        <dd>#{{ basket.basketId }}</dd>
                    </div>
                    <div class="admin-details__row">
                        <dt>Created</dt>
                        <dd>{{ basket.createdAt }}</dd>
                    </div>
                    <div class="admin-details__row">
                        <dt>Last activity</dt>
                        <dd>{{ basket.lastActivity }}</dd>
                    </div>
                    <div class="admin-details__row">
                        <dt>Status</dt>
                        <dd><span class="admin-status admin-status--success">{{ basket.status }}</span></dd>
                    </div>
                </dl>
            </section>

            <section class="admin-card" aria-labelledby="customer-information">
                <h2 id="customer-information" class="admin-card__title">Customer information</h2>
                <dl class="admin-details">
                    <div class="admin-details__row">
                        <dt>Name</dt>
                        <dd>{{ basket.customer.name }}</dd>
                    </div>
                    <div class="admin-details__row">
                        <dt>Email</dt>
                        <dd>{{ basket.customer.email }}</dd>
                    </div>
                </dl>
            </section>
        </div>

        <section class="admin-card" aria-labelledby="basket-contents">
            <h2 id="basket-contents" class="admin-card__title">Basket contents</h2>
            {% if basket.items | length %}
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th scope="col">Product</th>
                            <th scope="col" class="admin-numeric">Quantity</th>
                            <th scope="col" class="admin-numeric">Unit price</th>
                            <th scope="col" class="admin-numeric">Total price</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in basket.items %}
                        <tr>
                            <td>{{ item.productName }}</td>
                            <td class="admin-numeric">{{ item.quantity }}</td>
                            <td class="admin-numeric">{{ item.unitPrice }}</td>
                            <td class="admin-numeric">{{ item.totalPrice }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% else %}
            <p class="admin-empty" role="status">This basket is empty.</p>
            {% endif %}

            <dl class="admin-summary" aria-label="Basket summary">
                <div class="admin-summary__row">
                    <dt>Total items</dt>
                    <dd>{{ basket.itemCount }}</dd>
                </div>
                <div class="admin-summary__row admin-summary__row--total">
                    <dt>Basket total</dt>
                    <dd>{{ basket.total }}</dd>
                </div>
            </dl>
        </section>
        {% endif %}
    </main>
</body>

</html>
