<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if user %}{{ user.name }} | {% endif %}Users | Admin | Sedshed</title>
    <link rel="stylesheet" href="/admin.css">
</head>

<body class="admin">
    {% set activeNav = "users" %}
    {% include "partials/admin-nav.njk" %}

    <main id="main" class="admin-main">
        <a href="/admin/users" class="admin-back-link">&larr; Back to users</a>

        {% if notFound %}
        <header class="admin-page-head">
            <h1 class="admin-page-head__title">User not found</h1>
        </header>
        <p class="admin-empty admin-empty--panel">This user account does not exist.</p>
        {% elif error %}
        <header class="admin-page-head">
            <h1 class="admin-page-head__title">User details</h1>
        </header>
        <div class="admin-alert admin-alert--error" role="alert">
            <span>{{ error }}</span>
            <a href="/admin/users/{{ userId | urlencode }}">Retry</a>
        </div>
        {% else %}
        <header class="admin-page-head">
            <p class="admin-page-head__eyebrow">Customer</p>
            <h1 class="admin-page-head__title">{{ user.name }}</h1>
        </header>

        {% if updated == "suspended" %}
        <div class="admin-alert admin-alert--success" role="status">The account has been suspended.</div>
        {% elif updated == "reactivated" %}
        <div class="admin-alert admin-alert--success" role="status">The account has been reactivated.</div>
        {% endif %}
        {% if actionFailed %}
        <div class="admin-alert admin-alert--error" role="alert">The account status could not be updated. Please try again.</div>
        {% endif %}

        <section class="admin-card" aria-labelledby="customer-information">
            <h2 id="customer-information" class="admin-card__title">Customer information</h2>
            <dl class="admin-details">
                <div class="admin-details__row">
                    <dt>Name</dt>
                    <dd>{{ user.name }}</dd>
                </div>
                <div class="admin-details__row">
                    <dt>Email</dt>
                    <dd>{{ user.email }}</dd>
                </div>
                <div class="admin-details__row">
                    <dt>Registered</dt>
                    <dd>{{ user.displayRegisteredAt }}</dd>
                </div>
                <div class="admin-details__row">
                    <dt>Account status</dt>
                    <dd><span class="admin-status{% if user.isSuspended %} admin-status--danger{% else %} admin-status--success{% endif %}">{{ user.statusLabel }}</span></dd>
                </div>
            </dl>

            {% include "partials/admin-user-actions.njk" %}
        </section>

        <div class="admin-grid admin-grid--two">
            <section class="admin-card" aria-labelledby="orders-summary">
                <h2 id="orders-summary" class="admin-card__title">Recent orders</h2>
                <div class="admin-table-wrap">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th scope="col">Order</th>
                                <th scope="col">Date</th>
                                <th scope="col">Status</th>
                                <th scope="col" class="admin-numeric">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for order in recentOrders %}
                            <tr>
                                <td>#{{ order.id }}</td>
                                <td>{{ order.displayPlacedAt }}</td>
                                <td><span class="admin-status">{{ order.status }}</span></td>
                                <td class="admin-numeric">{{ order.displayTotal }}</td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="4" class="admin-empty">No orders yet.</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="admin-card" aria-labelledby="basket-summary">
                <h2 id="basket-summary" class="admin-card__title">Current basket</h2>
                {% if basket.items | length %}
                <div class="admin-table-wrap">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th scope="col">Product</th>
                                <th scope="col" class="admin-numeric">Quantity</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in basket.items %}
                            <tr>
                                <td>{{ item.productName }}</td>
                                <td class="admin-numeric">{{ item.quantity }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                        <tfoot>
                            <tr>
                                <th scope="row">{{ basket.itemCount }} item{% if basket.itemCount != 1 %}s{% endif %}</th>
                                <th class="admin-numeric">{{ basket.displaySubtotal }}</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                {% else %}
                <p class="admin-empty">The basket is empty.</p>
                {% endif %}
            </section>
        </div>
        {% endif %}
    </main>
</body>

</html>
