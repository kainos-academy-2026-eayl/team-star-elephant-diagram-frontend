{%- import "partials/icons.njk" as i -%}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sedshed | Home</title>
    <link rel="stylesheet" href="/home.css">
</head>

<body class="home">
    <header class="site-header">
        <a href="/" class="brand" aria-label="Sedshed home">
            <img src="/images/home/logo.png" alt="" width="80" height="42">
            <span class="brand__name">SEDSHED</span>
        </a>

        <form action="/products" method="get" class="site-search" role="search">
            <input type="search" name="q" placeholder="Search for something.." aria-label="Search products">
            <button type="submit" aria-label="Search">{{ i.icon("search") }}</button>
        </form>

        <div class="site-header__actions">
            <a href="/basket" class="icon-link" aria-label="Basket">{{ i.icon("cart") }}</a>
            <button type="button" class="icon-link" id="menu-open" aria-label="Open menu" aria-expanded="false" aria-controls="site-menu">{{ i.icon("menu") }}</button>
        </div>
    </header>

    <main>
        <section class="carousel" aria-roledescription="carousel" aria-label="Featured">
            <div class="carousel__track">
                {% for slide in slides %}
                <a class="carousel__slide{% if loop.first %} is-active{% endif %}" href="{{ slide.href }}" aria-label="{{ slide.label }}"{% if not loop.first %} aria-hidden="true" tabindex="-1"{% endif %}>
                    <img src="{{ slide.image }}" alt="{{ slide.label }}">
                </a>
                {% endfor %}
            </div>
            <button type="button" class="carousel__arrow carousel__arrow--prev" aria-label="Previous slide"></button>
            <button type="button" class="carousel__arrow carousel__arrow--next" aria-label="Next slide"></button>
            <div class="carousel__dots"></div>
        </section>

        <section class="tiles" aria-label="Shop highlights">
            {% for tile in smallTiles %}
            <a class="tile tile--small" href="{{ tile.href }}"><img src="{{ tile.image }}" alt="{{ tile.label }}" loading="lazy"></a>
            {% endfor %}
            {% for tile in largeTiles %}
            <a class="tile tile--large" href="{{ tile.href }}"><img src="{{ tile.image }}" alt="{{ tile.label }}" loading="lazy"></a>
            {% endfor %}
        </section>
    </main>

    <div class="menu-overlay" id="menu-overlay" hidden></div>

    <aside class="side-menu" id="site-menu" aria-label="Site menu" aria-hidden="true" inert>
        <div class="side-menu__top">
            <a href="/" class="side-menu__brand">
                <img src="/images/home/logo-menu.png" alt="" width="56" height="36">
                <span>Sedshed</span>
            </a>
            <button type="button" class="icon-link icon-link--dark" id="menu-close" aria-label="Close menu">{{ i.icon("close") }}</button>
        </div>

        <nav class="side-menu__nav" aria-label="Main">
            <ul>
                <li><a class="menu-item is-current" href="/" aria-current="page">{{ i.icon("home") }}<span>Home</span></a></li>
                {% for category in menuCategories %}
                <li><a class="menu-item" href="{{ category.href }}">{{ i.icon(category.icon) }}<span>{{ category.label }}</span></a></li>
                {% endfor %}
                <li><a class="menu-item" href="/products">{{ i.icon("tag") }}<span>Deals &amp; Offers</span></a></li>
            </ul>

            <ul class="menu-section">
                <li><a class="menu-item" href="/profile">{{ i.icon("user") }}<span>Account</span></a></li>
                <li><a class="menu-item" href="/profile">{{ i.icon("box") }}<span>Orders</span></a></li>
                <li><a class="menu-item" href="/products">{{ i.icon("heart") }}<span>Wishlist</span></a></li>
                <li><a class="menu-item" href="/basket">{{ i.icon("cart") }}<span>Cart</span>{% if cartCount %}<span class="menu-item__badge">{{ cartCount }}</span>{% endif %}</a></li>
            </ul>
        </nav>

        <a class="shipping-banner" href="/products">
            {{ i.icon("truck") }}
            <span><strong>Free Shipping</strong><small>On orders over £50</small></span>
            {{ i.icon("arrow") }}
        </a>

        <div class="help">
            <p class="help__title">Need Help?</p>
            <ul>
                <li><a href="/products">{{ i.icon("help") }}<span>FAQs</span></a></li>
                <li><a href="/products">{{ i.icon("mail") }}<span>Contact Us</span></a></li>
                <li><a href="/profile">{{ i.icon("pin") }}<span>Track Order</span></a></li>
            </ul>
        </div>

        <ul class="social" aria-label="Social media">
            <li><a href="/" aria-label="Instagram">{{ i.icon("instagram") }}</a></li>
            <li><a href="/" aria-label="Facebook">{{ i.icon("facebook") }}</a></li>
            <li><a href="/" aria-label="X">{{ i.icon("x") }}</a></li>
            <li><a href="/" aria-label="YouTube">{{ i.icon("youtube") }}</a></li>
        </ul>

        <p class="side-menu__copyright">© 2026 Sedshed. All rights reserved.</p>
    </aside>

    <script src="/home.js" defer></script>
</body>

</html>
