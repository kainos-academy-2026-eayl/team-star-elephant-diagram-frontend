<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link rel="stylesheet" href="/styles.css">
</head>

<body>
    <main class="login">
        <h1 class="login__title">{% if admin %}Admin log in{% else %}Log in{% endif %}</h1>
        <p class="login__intro">Welcome back.</p>

        {% if registered %}<p role="status">Account created. You can now log in.</p>{% endif %}
        {% if passwordReset %}<p role="status">Password reset. You can now log in with your new password.</p>{% endif %}
        {% if admin and sessionExpired %}<p role="status">Your session has expired. Please log in again.</p>{% endif %}
        {% if admin and forbidden %}<p role="alert">You need a staff account to access that page.</p>{% endif %}
        {% if error %}
        <div id="login-error" role="alert">
            <p>{{ error }}</p>
            {% for field, messages in details %}
            {% for message in messages %}<p>{{ field }}: {{ message }}</p>{% endfor %}
            {% endfor %}
        </div>
        {% endif %}

        <form class="login__form" action="{% if admin %}/admin/login{% else %}/login{% endif %}" method="post">
            {% if admin and returnTo %}<input type="hidden" name="returnTo" value="{{ returnTo }}">{% endif %}
            <div class="field">
                <label for="email">Email</label>
                <input type="email" name="email" id="email" autocomplete="email" value="{{ values.email }}" {% if invalidCredentials %}aria-invalid="true" aria-describedby="login-error"{% endif %} required>
            </div>

            <div class="field">
                <label for="password">Password</label>
                <input type="password" name="password" id="password" autocomplete="current-password" {% if invalidCredentials %}aria-invalid="true" aria-describedby="login-error"{% endif %} required>
            </div>

            <button type="submit" class="btn btn--primary">Log in</button>
        </form>

        <p class="login__switch">Don't have an account? <a href="/register">Create one</a></p>
        <p class="login__switch">Forgot your password? <a href="/forgot-password">Reset it</a></p>
        {% if not admin %}<p class="login__switch"><a href="/admin/login">Staff login</a></p>{% endif %}
    </main>
</body>

</html>