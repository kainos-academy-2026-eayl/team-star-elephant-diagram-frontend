import { Router } from "express";
import { ProductExpandedController } from "../controllers/ProductExpandedController";

export function ProductExpandedRoutes(productExpandedController: ProductExpandedController): Router {
    const router = Router();

    router.get("/health", (_req, res) => productExpandedController.health(res));
    router.get("/", (_req, res) => productExpandedController.home(res));
    router.get("/products/:id", (_req, res) => productExpandedController.getProductExpanded(_req, res));

    return router;
}