<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard | Shop</title>
    <link rel="stylesheet" href="/styles.css">
</head>

<body>
    <header class="navbar">
        <a href="/admin" class="navbar-brand">Admin</a>

        <input type="checkbox" id="menu-toggle" class="menu-toggle">
        <label for="menu-toggle" class="menu-button">
            <span>Menu</span>
            <span class="menu-arrow"></span>
        </label>

        <nav class="dropdown">
            <ul class="category-links">
                <li><a href="/admin" class="active">Dashboard</a></li>
                {% for section in sections %}
                <li><a href="{{ section.href }}">{{ section.label }}</a></li>
                {% endfor %}
            </ul>

            <div class="dropdown-actions">
                <span class="staff-name">{{ staff.name }}</span>
                <a href="/logout" class="action-button">Log out</a>
            </div>
        </nav>
    </header>

    {% set searchTypes = [["all", "All"], ["orders", "Orders"], ["products", "Products"], ["users", "Users"]] %}

    <div class="search-bar">
        <form action="/admin/search" method="get" class="search-form">
            <label for="admin-search" class="visually-hidden">Search orders, products and users</label>
            <input type="search" id="admin-search" name="q" placeholder="Search orders, products or users" value="{{ query }}">
            <select name="type" aria-label="Search in">
                {% for option in searchTypes %}
                <option value="{{ option[0] }}" {% if type == option[0] %}selected{% endif %}>{{ option[1] }}</option>
                {% endfor %}
            </select>
            <button type="submit">Search</button>
        </form>
    </div>

    <main class="container">
        <h1 class="section-heading">Admin dashboard</h1>

        {% if error %}
        <div class="error-message" role="alert">
            Admin data couldn't be loaded - please try again.
            <a href="/admin">Retry</a>
        </div>
        {% else %}

        {% if quickActions | length %}
        <section class="quick-actions" aria-label="Quick actions">
            {% for action in quickActions %}
            <a href="{{ action.href }}" class="action-button">{{ action.label }}</a>
            {% endfor %}
        </section>
        {% endif %}

        <section class="product-grid stat-grid" aria-label="Summary">
            {% for card in cards %}
            <a href="{{ card.href }}" class="product-card stat-card">
                <div class="product-info">
                    <h2>{{ card.label }}</h2>
                    <p class="product-price stat-value">{{ card.value }}</p>
                </div>
            </a>
            {% endfor %}
        </section>

        <div class="activity-grid">
            <section class="order-card">
                <h2>Latest orders</h2>
                <table class="order-items">
                    <thead>
                        <tr>
                            <th>Order</th>
                            <th>Customer</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for order in recentOrders %}
                        <tr>
                            <td><a href="/admin/orders/{{ order.id }}">#{{ order.id }}</a></td>
                            <td>{{ order.customer }}</td>
                            <td>{{ order.date }}</td>
                            <td><span class="order-status">{{ order.status }}</span></td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="4" class="order-empty">No recent orders.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </section>

            <section class="order-card">
                <h2>New registrations</h2>
                <table class="order-items">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Joined</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in newUsers %}
                        <tr>
                            <td><a href="/admin/users/{{ user.id }}">{{ user.name }}</a></td>
                            <td>{{ user.email }}</td>
                            <td>{{ user.joined }}</td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="3" class="order-empty">No new registrations.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </section>

            <section class="order-card">
                <h2>Recent stock changes</h2>
                <table class="order-items">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Change</th>
                            <th>Reason</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for change in stockChanges %}
                        <tr>
                            <td>{{ change.product }}</td>
                            <td>{{ change.amount }}</td>
                            <td>{{ change.reason }}</td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="3" class="order-empty">No recent stock changes.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </section>
        </div>

        {% endif %}
    </main>
</body>

</html>