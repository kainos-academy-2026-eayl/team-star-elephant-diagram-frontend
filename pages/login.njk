<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link rel="stylesheet" href="styles.css">
</head>

<body>
    <main class="login">
        <h1 class="login__title">Log in</h1>
        <p class="login__intro">Welcome back.</p>

        {% if registered %}<p role="status">Account created. You can now log in.</p>{% endif %}
        {% if error %}
        <div role="alert">
            <p>{{ error }}</p>
            {% for field, messages in details %}
            {% for message in messages %}<p>{{ field }}: {{ message }}</p>{% endfor %}
            {% endfor %}
        </div>
        {% endif %}

        <form class="login__form" action="/login" method="post">
            <div class="field">
                <label for="email">Email</label>
                <input type="email" name="email" id="email" autocomplete="email" value="{{ values.email }}" required>
            </div>

            <div class="field">
                <label for="password">Password</label>
                <input type="password" name="password" id="password" autocomplete="current-password" required>
            </div>

            <button type="submit" class="btn btn--primary">Log in</button>
        </form>

        <p class="login__switch">Don't have an account? <a href="/register">Create one</a></p>
    </main>
</body>

</html>