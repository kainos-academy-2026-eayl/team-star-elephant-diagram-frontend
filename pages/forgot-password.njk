<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot password</title>
    <link rel="stylesheet" href="/styles.css">
</head>

<body>
    <main class="login">
        <h1 class="login__title">Forgot your password?</h1>
        <p class="login__intro">Enter your account email to request a reset link.</p>

        {% if sent %}
        <p role="status">If an account exists for that email, a reset link has been requested. During local development, check the backend console for the link. Links expire after 15 minutes.</p>
        {% else %}
        {% if error %}
        <div class="login__error" role="alert">
            <p>{{ error }}</p>
            {% for field, messages in details %}
            {% for message in messages %}<p>{{ field }}: {{ message }}</p>{% endfor %}
            {% endfor %}
        </div>
        {% endif %}
        <form class="login__form" action="/forgot-password" method="post">
            <div class="field">
                <label for="email">Email</label>
                <input type="email" name="email" id="email" autocomplete="email" value="{{ values.email }}" required>
            </div>
            <button type="submit" class="btn btn--primary">Request reset link</button>
        </form>
        {% endif %}
        <p class="login__switch"><a href="/login">Back to log in</a></p>
    </main>
</body>

</html>
